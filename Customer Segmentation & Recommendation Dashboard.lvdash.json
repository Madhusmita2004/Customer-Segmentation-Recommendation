{
  "datasets": [
    {
      "name": "engagement_summary",
      "displayName": "Engagement Summary",
      "config": {
        "source": "workspace.default.gold_engagement_summary",
        "measures": [
          {
            "name": "total_events",
            "expr": "SUM(total_events)"
          },
          {
            "name": "unique_customers",
            "expr": "SUM(unique_customers)"
          }
        ],
        "version": "1.1",
        "comment": "Event counts and unique customers per engagement event type",
        "dimensions": [
          {
            "name": "event_type",
            "expr": "event_type"
          }
        ]
      }
    },
    {
      "name": "recommendation_performance",
      "displayName": "Recommendation Performance",
      "config": {
        "source": "workspace.default.gold_recommendation_performance",
        "measures": [
          {
            "name": "total_recommendations",
            "expr": "SUM(total_recommendations)"
          },
          {
            "name": "converted_recommendations",
            "expr": "SUM(converted_recommendations)"
          },
          {
            "name": "total_purchases",
            "expr": "SUM(total_purchases)"
          },
          {
            "name": "conversion_rate",
            "expr": "SUM(converted_recommendations) * 1.0 / SUM(total_recommendations)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Recommendation outcomes and conversion rate per recommended action",
        "dimensions": [
          {
            "name": "recommended_action",
            "expr": "recommended_action"
          }
        ]
      }
    },
    {
      "name": "customer_spending",
      "displayName": "Customer Spending",
      "config": {
        "source": "workspace.default.gold_customer_spending",
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(total_revenue)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "abbreviation": "compact"
            }
          },
          {
            "name": "avg_customer_revenue",
            "expr": "AVG(total_revenue)",
            "format": {
              "type": "currency",
              "currencyCode": "USD"
            }
          },
          {
            "name": "total_orders",
            "expr": "SUM(total_orders)"
          },
          {
            "name": "customer_count",
            "expr": "COUNT(1)"
          }
        ],
        "version": "1.1",
        "comment": "Per-customer revenue, orders, and attributes from the RFM analysis",
        "dimensions": [
          {
            "name": "acquisition_channel",
            "expr": "acquisition_channel"
          },
          {
            "name": "gender",
            "expr": "gender"
          },
          {
            "name": "city",
            "expr": "city"
          },
          {
            "name": "account_status",
            "expr": "account_status"
          }
        ]
      }
    },
    {
      "name": "segment_summary",
      "displayName": "Segment Summary",
      "config": {
        "source": "workspace.default.gold_segment_summary",
        "measures": [
          {
            "name": "total_customers",
            "expr": "SUM(total_customers)"
          },
          {
            "name": "avg_rfm_score",
            "expr": "AVG(average_rfm_score)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Customer counts and average RFM score per customer segment",
        "dimensions": [
          {
            "name": "segment_name",
            "expr": "segment_name"
          }
        ]
      }
    },
